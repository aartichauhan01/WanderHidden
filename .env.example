# WanderHidden - Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# The application gracefully falls back to interactive Demo Mode if these are unconfigured.

# Supabase Credentials (from your Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for secure server-side administration only - NEVER expose on client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Maps JavaScript API Key (from Google Cloud Console)
# Enable Maps JavaScript API and Geocoding API
# When absent, WanderHidden provides an interactive SVG/Leaflet-inspired fallback map view
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
